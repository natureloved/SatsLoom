{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/shared/src/**/*.ts",
    "packages/router/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "packages/ecommerce/src/**/*.ts",
    "packages/bolt11/src/**/*.ts",
    "packages/rails/src/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
