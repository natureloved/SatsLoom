{
  "name": "satsloom",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "build": "npm run build --workspace @satsloom/web",
    "typecheck": "tsc --noEmit",
    "spike:tachi": "node --experimental-strip-types scripts/spike-tachi.ts",
    "test": "vitest run",
    "smoke:api": "node scripts/smoke-api.mjs",
    "audit:liveness": "tsx scripts/liveness-audit.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
