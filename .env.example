# Local demo only. Set false in production unless simulation routes are intentionally public.
SATSLOOM_DEMO_MODE=true
# Required to issue x402 signed demo receipts in production; use a high-entropy secret.
SATSLOOM_PROOF_SECRET=
# Required for non-public API routes when simulation mode is disabled.
SATSLOOM_ADMIN_TOKEN=
# Both values are required before an invoice may register a webhook destination.
# Use exact HTTPS origins for trusted, publicly reachable hosts only.
SATSLOOM_WEBHOOK_ALLOWED_ORIGINS=
SATSLOOM_WEBHOOK_SECRET=
# Optional local single-process JSON file path. Do not use as serverless/shared storage.
# SATSLOOM_DATA_FILE=./apps/api/data/satsloom.json

# Optional explicit browser origin for API CORS. In local development, localhost:5173/5174 are allowed.
# WEB_ORIGIN=http://localhost:5174

# ---------------------------------------------------------------------------
# Tachi / TAURUS integration spike
#
# The public demo settlement API does NOT call these. They drive the separate
# opt-in spike: `npm run spike:tachi`.
#
# TACHI_NETWORK selects the chain. Two values are supported by the Tachi wallet
# aggregator, and they are funded completely differently:
#
#   signet (default)
#     - Tachi daemon:   https://rpc-signet.tachibtc.com   (chain id tachi-signet-1)
#     - Explorer:       https://signet.tachibtcscan.com
#     - Funding:        public no-auth Bitcoin signet faucet. Claim into the
#                       P2WPKH wallet, then deposit from it into the vault's P2TR.
#                       Signet blocks average ~10 minutes, so a deposit needs a
#                       real wait before it can be registered.
#     - Tachi's own faucet (https://faucet.tachibtc.com) also funds signet but
#       requires GitHub/X sign-in, so it cannot be driven from a script.
#
#   regtest
#     - Tachi daemon:   https://rpc-regtest.tachibtc.com  (chain id tachi-regtest-1)
#     - Explorer:       https://regtest.tachibtcscan.com
#     - Funding:        a LOCAL bitcoind (BITCOIN_RPC_* below), mined locally.
#                       Requires a running `bitcoind -regtest -server -txindex=1`.
#
# Signet coins have no value. Anything reporting this rail as live must label it
# as signet test coins.
# ---------------------------------------------------------------------------
TACHI_NETWORK=signet
# TACHI_DAEMON_RPC_URL=https://rpc-signet.tachibtc.com
# TACHI_EXPLORER_URL=https://signet.tachibtcscan.com
# TACHI_FAUCET_URL=https://faucet.rgbmap.org/v1/faucet
TACHI_RPC_TIMEOUT_MS=30000

# A disposable seed is generated automatically when this is unset, which is what
# you want for signet: vaults accept exactly one deposit, so a fresh key keeps
# each run from colliding with the last one. Set it only to reproduce a run.
# TACHI_TEST_MNEMONIC=

# regtest only: local bitcoind credentials.
# BITCOIN_RPC_URL=http://127.0.0.1:18443
# BITCOIN_RPC_USERNAME=regtest-user
# BITCOIN_RPC_PASSWORD=<local-regtest-password>
# BITCOIN_FUNDING_WALLET=dev

# Mutates the chain by funding/depositing. Off unless explicitly enabled.
# On signet this consumes a real faucet payout (one per address per day) and
# waits for a real block confirmation.
TACHI_SPIKE_ENABLE_DEPOSIT=false
TACHI_SPIKE_DEPOSIT_SATS=100000
TACHI_MAX_FEE_SATS=1000
TACHI_TRANSFER_FEE_SATS=500
TACHI_EXIT_FEE_SATS=300
