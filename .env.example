# ─────────────────────────────────────────────────────────────────────────────
# SatsLoom configuration. Copy to `.env` and fill in. Nothing here is required
# to run in fixture mode (TACHI_PROVIDER=fixture), which is how CI and the
# screenshot/demo path run without network access.
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider ────────────────────────────────────────────────────────────────
# live    : talk to a real Tachi daemon (default). Requires key material below.
# fixture : in-process ledger. Real key derivation + real signing, no network.
TACHI_PROVIDER=live
TACHI_NETWORK=regtest
TACHI_DAEMON_URL=https://rpc-regtest.tachibtc.com
TACHI_EXPLORER_URL=https://explorer-regtest.tachibtc.com
TACHI_FAUCET_URL=https://faucet.tachibtc.com
TACHI_TIMEOUT_MS=20000
# Relative-timelock (CSV) blocks for the unilateral-exit leaf. Must match the
# daemon's expectation for your quorum or the derived address diverges.
TACHI_CSV_BLOCKS=1008
# How long to wait for an epoch to commit a transaction, and how often to poll.
TACHI_COMMIT_TIMEOUT_MS=900000
TACHI_COMMIT_POLL_MS=2000

# ── SERVER-SIDE KEY MATERIAL — TEST ONLY ────────────────────────────────────
# REGTEST TEST KEYS ONLY. These are published BIP-39 test vectors; they are
# worthless and public. Never use them anywhere value exists.
#
# Generate your own with: node -e "import('@tachibtc/taurus-wallet-aggregator').then(m=>console.log(m.generateMnemonic()))"
# Every *_MNEMONIC also accepts a *_MNEMONIC_FILE path for Docker/Fly secrets.
MERCHANT_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
DEMO_PAYER_MNEMONIC="legal winner thank year wave sausage worth useful legal winner thank yellow"
COLD_MNEMONIC="letter advice cage absurd amount doctor acoustic avoid letter advice cage above"

# ── Merchant policy ─────────────────────────────────────────────────────────
MERCHANT_NAME=SatsLoom Demo Merchant
MAX_FEE_SATS=1000
MAX_SETTLEMENT_SECONDS=600
WEIGHT_FEE=0.2
WEIGHT_LATENCY=0.35
WEIGHT_EXIT_RISK=0.35
WEIGHT_LIQUIDITY=0.1
# A Taproot (bcrt1p…) address for on-chain sweeps. Leave empty to disable the
# on-chain redemption route (it will report itself unavailable, not fake it).
PAYOUT_ADDRESS=

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# When set, write endpoints require `X-Api-Key`. Set this for anything public.
SATSLOOM_API_KEY=
INVOICE_TTL_SECONDS=900
DETECTION_INTERVAL_MS=2000
LEDGER_FEE_SATS=1
# `/api/demo/*` helpers (fund the merchant, pay an invoice from the demo wallet).
# Turn these OFF for any deployment that is not a demo.
ENABLE_DEMO_ROUTES=true

# ── Web ─────────────────────────────────────────────────────────────────────
# Leave empty to use the same-origin `/api` proxy (recommended: works with the
# Vite dev proxy, Docker Compose nginx and the Vercel rewrite). Only set this to
# an absolute URL if the API lives on a different host.
VITE_API_URL=
