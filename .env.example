TACHI_DAEMON_RPC_URL=https://rpc-regtest.tachibtc.com
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USERNAME=tachi
BITCOIN_RPC_PASSWORD=tachi
BITCOIN_FUNDING_WALLET=dev
TACHI_EXPLORER_URL=https://regtest.tachibtcscan.com
TACHI_RPC_TIMEOUT_MS=30000
# Test-only regtest mnemonic. Never use a mnemonic holding real funds.
TACHI_TEST_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about
# Mutates the local regtest chain by funding and depositing 100,000 sats.
TACHI_SPIKE_ENABLE_DEPOSIT=false
TACHI_SPIKE_DEPOSIT_SATS=100000
TACHI_MAX_FEE_SATS=1000
TACHI_TRANSFER_FEE_SATS=500
TACHI_EXIT_FEE_SATS=300
# Optional explicit browser origin. Without this, localhost:5173/5174 are allowed.
# WEB_ORIGIN=http://localhost:5174
