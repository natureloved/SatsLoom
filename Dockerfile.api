FROM node:22-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY tsconfig.json ./

RUN npm ci --workspace @satsloom/domain --workspace @satsloom/router --workspace @satsloom/shared --workspace @satsloom/tachi-adapter --workspace @satsloom/api

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV SATSLOOM_DATA_FILE=/app/data/satsloom.json

COPY --from=builder /app ./

RUN mkdir -p /app/data

EXPOSE 3001

CMD ["node", "--experimental-strip-types", "apps/api/src/server.ts"]
